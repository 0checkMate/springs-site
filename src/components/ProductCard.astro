---
import type { Product } from '../data/products';
interface Props { p: Product }
const { p } = Astro.props;
---
<a class="card rv product-card" href={`/${p.slug}/`}>
  <div class="product-card-image">
    <img
      src={p.images[0]}
      alt={p.name}
      loading="lazy"
    />
  </div>

  <div class="product-card-content">
    <h3>{p.name}</h3>
    {p.latin && <div class="tag">{p.latin}</div>}
    <p>{p.summary} Pack sizes: {p.packs.join(', ')}.</p>
    <span class="more">{p.cta} &rarr;</span>
  </div>
</a>
