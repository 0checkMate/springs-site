---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { byCategory } from '../data/products';
import { site, waLink } from '../data/site';
const spawnTiles = [...byCategory('spawn'), ...byCategory('culture')];
const freshTiles = byCategory('fresh');
---
<Base
  scene
  title={`Quality Mushroom Spawn & Fresh Mushrooms | ${site.legalName}`}
  description="Professionally produced button, cremini/brown and oyster mushroom spawn and fresh mushrooms for growers, retailers, restaurants and commercial buyers."
>
<main id="top">
<header class="hero"><div class="wrap">
  <div class="eyebrow">Button &bull; Cremini &bull; Oyster</div>
  <h1>Quality Mushroom Spawn <em>&amp; Fresh Mushrooms</em></h1>
  <p class="lead">Professionally produced mushroom spawn and fresh mushrooms for growers, retailers, restaurants and other commercial customers. Laboratory to harvest, we understand the whole chain.</p>
  <div class="cta"><a class="btn p" href="#spawn">Order Spawn</a><a class="btn g" href="#fresh">Enquire About Fresh Mushrooms</a></div>
</div></header>

<section id="fresh"><div class="wrap">
  <h2 class="rv">Fresh Mushrooms</h2><p class="sub rv">Fresh button and cremini/brown mushrooms, grown by the team that produces our spawn. Wholesale and retail available.</p>
  <div class="grid carousel">
    {freshTiles.map((p) => <ProductCard p={p} />)}
    <div class="card rv"><h3>Current Availability</h3><p>[AVAILABILITY - update regularly]</p><a class="more" href="#contact">Enquire / Order &rarr;</a></div>
  </div>
</div></section>

<section id="spawn"><div class="wrap">
  <h2 class="rv">Our Mushroom Spawn and Pure Cultures</h2><p class="sub rv">Laboratory-produced spawn and pure cultures for commercial and small-scale growers.</p>
  <div class="grid carousel">
    {spawnTiles.map((p) => <ProductCard p={p} />)}
  </div>
</div></section>

<section class="alt"><div class="wrap">
  <h2 class="rv">Why Choose Our Spawn?</h2><p class="sub rv">Spawn is a living input. Your crop starts with it, so we control how it is made.</p>
  <div class="grid carousel">
    <div class="card rv"><h3>Laboratory Production</h3><p>Aseptic laboratory conditions with laminar-flow equipment.</p></div>
    <div class="card rv"><h3>Quality Control</h3><p>Colonisation monitoring and contamination inspection at defined stages.</p></div>
    <div class="card rv"><h3>Trained Personnel</h3><p>Staff trained in mushroom cultivation, microbiology and laboratory procedure.</p></div>
    <div class="card rv"><h3>Practical Growing Experience</h3><p>We grow mushrooms ourselves, so we know what spawn must deliver.</p></div>
  </div>
</div></section>

<section id="lab"><div class="wrap">
  <h2 class="rv">Our Spawn Lab</h2><p class="sub rv">A controlled, step-by-step process from culture to finished spawn.</p>
  <div class="flow rv"><span>Culture preparation</span><span>Mother culture</span><span>Grain preparation</span><span>Sterilisation</span><span>Inoculation</span><span>Incubation</span><span>Quality control</span><span>Finished spawn</span></div>
  <div class="ph rv">[PHOTO: laboratory, laminar-flow work, spawn bags in incubation]</div>
  <p class="rv" style="margin-top:22px"><a class="more" href="#lab">Explore the Laboratory &rarr;</a></p>
</div></section>

<section id="about" class="alt"><div class="wrap cols">
  <div class="rv"><h2>Experienced People. Controlled Production.</h2><p class="sub">Spawn production is supported by trained personnel with relevant expertise in mushroom cultivation, microbiology, laboratory procedures and quality control.</p><a class="more" href="#about">Meet Our Team &rarr;</a></div>
  <div class="ph rv">[PHOTO: [STAFF NAME], [ROLE], in the laboratory]</div>
</div></section>

<section id="grow" class="alt"><div class="wrap">
  <h2 class="rv">For Mushroom Growers</h2><p class="sub rv">The Grower's Knowledge Centre: spawn selection, growing guides, substrate information, production advice, common problems and FAQs.</p>
  <div class="grid carousel">
    <a class="card rv" href="#grow"><h3>How to select good button mushroom spawn</h3><span class="more">Read &rarr;</span></a>
    <a class="card rv" href="#grow"><h3>How much spawn per tonne of compost</h3><span class="more">Read &rarr;</span></a>
    <a class="card rv" href="#grow"><h3>Causes of slow spawn colonisation</h3><span class="more">Read &rarr;</span></a>
    <a class="card rv" href="#grow"><h3>Harvesting and post-harvest handling</h3><span class="more">Read &rarr;</span></a>
  </div>
  <div class="cta"><a class="btn g" href="#grow">Visit Grower's Knowledge Centre</a></div>
</div></section>

<!-- Wholesale section kept out for now. Restore when ready.
<section id="wholesale"><div class="wrap">
  <h2 class="rv">Wholesale Fresh Mushrooms</h2>
</div></section> -->

<section class="final alt" id="contact"><div class="wrap">
  <h2 class="rv">Ready to Order?</h2><p class="sub rv" style="margin-inline:auto">Phone: {site.phone} &bull; Email: {site.email} &bull; {site.location} &bull; {site.hours}</p>
  <div class="cta"><a class="btn p" href={waLink()} data-track="whatsapp-home">WhatsApp Us</a><a class="btn g" href={`mailto:${site.email}`}>Request a Quote</a></div>
</div></section>
</main>
</Base>
